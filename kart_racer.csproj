<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <!-- Off-spec experimental work kept out of the shipping build (see experimental/README.md). -->
  <ItemGroup>
    <Compile Remove="experimental/**/*.cs" />
    <GodotSdkRootFiles Remove="experimental/**/*" />
  </ItemGroup>
</Project>
